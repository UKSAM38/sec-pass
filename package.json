{
  "name": "sec-pass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "test": "node --test tests/*.test.cjs",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --mac --arm64",
    "test:desktop": "node tests/electron-smoke.cjs",
    "format": "prettier --write src desktop tests main.cjs build/harden.cjs",
    "test:security": "node tests/electron-security.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.344.0",
    "prettier": "3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "io.github.uksam38.secpass.desktop",
    "productName": "SecPass",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "main.cjs",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "-"
    },
    "dmg": {
      "title": "SecPass"
    },
    "afterPack": "build/harden.cjs"
  },
  "main": "main.cjs",
  "description": "SecPass — yerel ve şifreli kişisel parola kasası",
  "author": "Samet Uçar"
}
